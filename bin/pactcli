#!/usr/bin/env python3
"""pactcli — CLI for the PACT plugin family.

  pactcli status                  overview of every PACT plugin's state
  pactcli bar on|off|toggle       swap between the PACT bar and the stock bar
  pactcli bar status              show preference, theme, and the active bar
  pactcli bar apply               re-assert for the current theme (theme-set hook)
  pactcli clock on|off|status     swap the stock bar's clock to/from pact.clock
  pactcli lock on|off|status      enable/disable the pact.lock lock screen
  pactcli window status|counter|emergency|close    open/close a PACT window
  pactcli menu <1-10>             open a section submenu
  pactcli focus                   toggle bar keyboard-focus mode
  pactcli config get <key>        read a config value (dotted key, e.g. bar.unit)
  pactcli config set <key> <val>  write a config value

Config: ~/.config/omarchy/pact/config.toml (live-reloaded by the bar).
The bar swap preference is [bar] replace; only one bar can occupy the
shell's bar slot, and whichever bar is active hosts all plugin widgets.
clock/lock only act when the matching plugin is installed under
~/.config/omarchy/plugins/.
"""
import json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
SHELL_JSON = f"{HOME}/.config/omarchy/shell.json"
CONFIG = f"{HOME}/.config/omarchy/pact/config.toml"
PACT_BAR = "pact.bar"
STOCK_BAR = "omarchy.bar"


def current_theme():
    try:
        name = open(f"{HOME}/.local/state/omarchy/current/theme.name").read()
        return name.strip().lower().replace(" ", "-")
    except OSError:
        return ""


def read_config():
    try:
        return open(CONFIG).read()
    except FileNotFoundError:
        return ""


def config_get(dotted, default=None):
    parts = dotted.split(".", 1)
    if len(parts) != 2:
        return default
    section, key = parts
    m = re.search(
        rf"^\[{re.escape(section)}\][^\[]*?^\s*{re.escape(key)}\s*=\s*(.+?)\s*$",
        read_config(), re.M | re.S)
    if not m:
        return default
    raw = m.group(1)
    raw = re.sub(r"\s+#.*$", "", raw).strip()
    if raw.startswith('"') and raw.endswith('"'):
        return raw[1:-1]
    return raw


def config_set(dotted, value):
    parts = dotted.split(".", 1)
    if len(parts) != 2:
        sys.exit(f"key must be section.key, got: {dotted}")
    section, key = parts
    if re.fullmatch(r"-?\d+(\.\d+)?|true|false", value):
        rendered = value
    else:
        rendered = '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
    text = read_config()
    sec_pat = rf"^\[{re.escape(section)}\]"
    if re.search(sec_pat, text, re.M):
        key_pat = rf"(^\[{re.escape(section)}\][^\[]*?^(\s*){re.escape(key)}\s*=\s*).+?$"
        if re.search(key_pat, text, re.M | re.S):
            text = re.sub(key_pat, rf"\g<1>{rendered}", text,
                          count=1, flags=re.M | re.S)
        else:
            text = re.sub(rf"({sec_pat}\s*\n)", rf"\g<1>{key} = {rendered}\n",
                          text, count=1, flags=re.M)
    else:
        text = text.rstrip("\n") + f"\n\n[{section}]\n{key} = {rendered}\n"
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    open(CONFIG, "w").write(text)


def set_slot_bar(bar_id):
    with open(SHELL_JSON) as f:
        config = json.load(f)
    bar = config.setdefault("bar", {})
    if bar.get("id", STOCK_BAR) != bar_id:
        if bar_id == STOCK_BAR:
            bar.pop("id", None)
        else:
            bar["id"] = bar_id
        with open(SHELL_JSON, "w") as f:
            json.dump(config, f, indent=2)
            f.write("\n")


def bar_pref():
    value = config_get("bar.replace")
    if value is None:
        # Legacy location: [pact] replace-bar in the user shell.toml.
        m = re.search(r"^\[pact\][^\[]*?^replace-bar\s*=\s*\"?(\w+)\"?",
                      _read(f"{HOME}/.config/omarchy/shell.toml"), re.M | re.S)
        value = m.group(1) if m else "on"
    return value


def _read(path):
    try:
        return open(path).read()
    except FileNotFoundError:
        return ""


def bar_apply():
    want_pact = bar_pref() != "off" and current_theme() == "silo"
    set_slot_bar(PACT_BAR if want_pact else STOCK_BAR)
    print("bar:", PACT_BAR if want_pact else STOCK_BAR)


def shell_ipc(*args):
    subprocess.run(["omarchy-shell", "pact.bar", *args], check=False)


def plugin_installed(plugin_id):
    return os.path.isdir(f"{HOME}/.config/omarchy/plugins/{plugin_id}")


def require_plugin(plugin_id):
    if not plugin_installed(plugin_id):
        sys.exit(f"{plugin_id} is not installed — clone "
                 f"https://github.com/didlix/omarchy-plugin.{plugin_id.replace('.', '-')} "
                 f"into ~/.config/omarchy/plugins/{plugin_id}")


def clock_state(config):
    for section in ("left", "center", "right"):
        for entry in config.get("bar", {}).get("layout", {}).get(section, []):
            if isinstance(entry, dict) and entry.get("id") in ("pact.clock", "omarchy.clock"):
                return entry["id"]
    return None


def clock_swap(want_pact):
    require_plugin("pact.clock")
    target = "pact.clock" if want_pact else "omarchy.clock"
    other = "omarchy.clock" if want_pact else "pact.clock"
    with open(SHELL_JSON) as f:
        config = json.load(f)
    changed = False
    for section in ("left", "center", "right"):
        for entry in config.get("bar", {}).get("layout", {}).get(section, []):
            if isinstance(entry, dict) and entry.get("id") == other:
                entry["id"] = target
                changed = True
    if config.get("bar", {}).get("centerAnchor") == other:
        config["bar"]["centerAnchor"] = target
        changed = True
    if changed:
        with open(SHELL_JSON, "w") as f:
            json.dump(config, f, indent=2)
            f.write("\n")
    print("clock:", target, "" if changed else "(already)")


def lock_state(config):
    plugins = [p.get("id") for p in config.get("plugins", []) if isinstance(p, dict)]
    return "pact.lock" if "pact.lock" in plugins else "omarchy.lock"


def lock_swap(want_pact):
    require_plugin("pact.lock")
    with open(SHELL_JSON) as f:
        config = json.load(f)
    plugins = config.setdefault("plugins", [])
    disabled = config.setdefault("disabledPlugins", [])
    have = any(isinstance(p, dict) and p.get("id") == "pact.lock" for p in plugins)
    if want_pact and not have:
        plugins.append({"id": "pact.lock"})
        if "omarchy.lock" not in disabled:
            disabled.append("omarchy.lock")
    elif not want_pact and have:
        config["plugins"] = [p for p in plugins
                             if not (isinstance(p, dict) and p.get("id") == "pact.lock")]
        config["disabledPlugins"] = [d for d in disabled if d != "omarchy.lock"]
    else:
        print("lock:", "pact.lock" if want_pact else "omarchy.lock", "(already)")
        return
    with open(SHELL_JSON, "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")
    print("lock:", "pact.lock" if want_pact else "omarchy.lock")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "help"

    if cmd == "status":
        with open(SHELL_JSON) as f:
            config = json.load(f)
        active = config.get("bar", {}).get("id", STOCK_BAR)
        print(f"theme:  {current_theme()}\n"
              f"bar:    {active}  (preference: replace = {bar_pref()})\n"
              f"clock:  {clock_state(config) or 'none in layout'}"
              + ("" if plugin_installed("pact.clock") else "  [pact.clock not installed]") + "\n"
              f"lock:   {lock_state(config)}"
              + ("" if plugin_installed("pact.lock") else "  [pact.lock not installed]"))
    elif cmd == "clock":
        sub = args[1] if len(args) > 1 else "status"
        if sub == "on":
            clock_swap(True)
        elif sub == "off":
            clock_swap(False)
        elif sub == "status":
            with open(SHELL_JSON) as f:
                print("clock:", clock_state(json.load(f)) or "none in layout")
        else:
            sys.exit("usage: pactcli clock on|off|status")
    elif cmd == "lock":
        sub = args[1] if len(args) > 1 else "status"
        if sub == "on":
            lock_swap(True)
        elif sub == "off":
            lock_swap(False)
        elif sub == "status":
            with open(SHELL_JSON) as f:
                print("lock:", lock_state(json.load(f)))
        else:
            sys.exit("usage: pactcli lock on|off|status")
    elif cmd == "bar":
        sub = args[1] if len(args) > 1 else "status"
        if sub in ("on", "off"):
            config_set("bar.replace", sub); bar_apply()
        elif sub == "toggle":
            config_set("bar.replace", "off" if bar_pref() != "off" else "on")
            bar_apply()
        elif sub == "apply":
            bar_apply()
        elif sub == "status":
            with open(SHELL_JSON) as f:
                active = json.load(f).get("bar", {}).get("id", STOCK_BAR)
            print(f"preference: bar.replace = {bar_pref()}\n"
                  f"theme: {current_theme()}\nactive bar: {active}")
        else:
            sys.exit(__doc__.strip())
    elif cmd == "window":
        key = args[1] if len(args) > 1 else ""
        if key == "close":
            shell_ipc("closeWindow")
        elif key in ("status", "counter", "emergency"):
            shell_ipc("openWindow", key)
        else:
            sys.exit("usage: pactcli window status|counter|emergency|close")
    elif cmd == "menu":
        if len(args) < 2 or not args[1].isdigit():
            sys.exit("usage: pactcli menu <1-10>")
        shell_ipc("openMenu", args[1])
    elif cmd == "focus":
        shell_ipc("focus")
    elif cmd == "config":
        sub = args[1] if len(args) > 1 else ""
        if sub == "get" and len(args) == 3:
            value = config_get(args[2])
            print("" if value is None else value)
        elif sub == "set" and len(args) == 4:
            config_set(args[2], args[3])
        else:
            sys.exit("usage: pactcli config get <section.key> | set <section.key> <value>")
    else:
        print(__doc__.strip())
        sys.exit(0 if cmd in ("help", "-h", "--help") else 2)


if __name__ == "__main__":
    main()
